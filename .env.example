APP_ENV=development
DATABASE_URL=postgresql://postgres:replace-with-database-password@localhost:5432/enterprise_ai
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
APP_VERSION=1.0.0
MCP_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_SERVER_URL=http://localhost:8000/mcp
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen3:4b-instruct
LLM_CONTEXT_WINDOW=8192
LLM_MAX_OUTPUT_TOKENS=512
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
RETRIEVAL_SCORE_THRESHOLD=0.55
RETRIEVAL_TOP_K=6
RERANK_TOP_K=2
CONVERSATION_HISTORY_LIMIT=30
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=30
CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=20
CONVERSATION_SUMMARY_MAX_CHARS=6000
CONVERSATION_SUMMARY_BATCH_MESSAGES=20
CONVERSATION_SUMMARY_INPUT_MAX_CHARS=16000
LOG_LEVEL=INFO
METRICS_ENABLED=true
LANGSMITH_TRACING_V2=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Keep false in production; enable only in controlled debugging environments.
LANGSMITH_CAPTURE_CONTENT=false
LANGSMITH_USE_SYSTEM_CA_STORE=true
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
# Optional corporate CA bundle; never disable TLS certificate verification.
SSL_CERT_FILE=
