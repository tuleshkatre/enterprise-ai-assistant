# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=production
APP_VERSION=1.0.0
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
LOG_LEVEL=INFO

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://app_user:replace-with-strong-password@db.example.com:5432/enterprise_ai

# =============================================================================
# AUTHENTICATION AND SECURITY
# =============================================================================
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# AI PROVIDER SELECTION
# =============================================================================
AI_PROVIDER=gemini
EMBEDDING_DIMENSION=768
LLM_CONTEXT_WINDOW=8192
LLM_MAX_OUTPUT_TOKENS=512

# =============================================================================
# LOCAL OLLAMA PROVIDER
# =============================================================================
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=qwen3:4b-instruct

# =============================================================================
# HOSTED GEMINI PROVIDER
# =============================================================================
GOOGLE_API_KEY=replace-with-google-ai-api-key
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# =============================================================================
# RETRIEVAL AND RERANKING
# =============================================================================
RETRIEVAL_SCORE_THRESHOLD=0.55
RETRIEVAL_TOP_K=6
RERANK_TOP_K=2

# =============================================================================
# CONVERSATION AND SUMMARY MEMORY
# =============================================================================
CONVERSATION_HISTORY_LIMIT=30
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=30
CONVERSATION_SUMMARY_KEEP_RECENT_MESSAGES=20
CONVERSATION_SUMMARY_MAX_CHARS=6000
CONVERSATION_SUMMARY_BATCH_MESSAGES=20
CONVERSATION_SUMMARY_INPUT_MAX_CHARS=16000

# =============================================================================
# OBSERVABILITY
# =============================================================================
METRICS_ENABLED=true
LANGSMITH_TRACING_V2=true
LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGSMITH_PROJECT=enterprise-ai-assistant-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_CAPTURE_CONTENT=false
LANGSMITH_USE_SYSTEM_CA_STORE=true
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# =============================================================================
# MODEL CONTEXT PROTOCOL
# =============================================================================
MCP_ISSUER_URL=https://api.example.com
MCP_RESOURCE_SERVER_URL=https://api.example.com/mcp
